# AgentEvalOps — Environment Configuration Reference
# Copy this file to .env for local development: cp .env.example .env

# General Application Settings
APP_ENV=development
APP_NAME=AgentEvalOps
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-super-secret-key-32bytes

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=agentevalops
POSTGRES_PASSWORD=agentevalops_dev_pass
POSTGRES_DB=agentevalops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agentevalops:agentevalops_dev_pass@localhost:5432/agentevalops
TEST_DATABASE_URL=postgresql+asyncpg://agentevalops:agentevalops_dev_pass@localhost:5432/agentevalops_test

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant - Optional Local / Cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Provider API Keys (External Evaluation / Judges)
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
GOOGLE_API_KEY=AIza-placeholder

# Telemetry & Observability
OTEL_SERVICE_NAME=agentevalops-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Third-Party Telemetry & Tracking Placeholders
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=https://cloud.langfuse.com

MLFLOW_TRACKING_URI=http://localhost:5000
SENTRY_DSN=
